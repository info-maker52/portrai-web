# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit secrets.

# ----------------------------------------------------------------------
# Site URL (used for canonical tags, OG images, sitemap)
# ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://portrai.cloud"

# ----------------------------------------------------------------------
# SMTP — booking form email delivery via Gmail Workspace
# Get App Password at https://myaccount.google.com/apppasswords
# ----------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="info@portrai.ee"
SMTP_PASSWORD=""  # 16-char Gmail App Password — never commit
SMTP_FROM="PortrAI <info@portrai.ee>"
SMTP_TO="info@portrai.ee"

# ----------------------------------------------------------------------
# Optional: design page gating in production
# Set to a strong random string; visit /design?key=<value> to view in prod
# ----------------------------------------------------------------------
DESIGN_PAGE_KEY=""

# ----------------------------------------------------------------------
# Intro / enter screen — Spline 3D scene
# ----------------------------------------------------------------------
# If set, the intro overlay renders this Spline scene as the background
# (Unseen.co-style 3D parallax world). If unset, falls back to the
# hand-coded Three.js IntroScene (geometric primitives).
#
# How to get a URL:
#   1. Sign up at https://spline.design (free)
#   2. Either:
#      a) Open https://community.spline.design and remix a scene you like
#         (search "interior", "dreamy", "abstract", "surreal"), OR
#      b) Build your own from scratch in the editor
#   3. In the editor: top-right → "Export" → "Code Export" → "React"
#   4. Copy the URL ending in `.splinecode` (e.g.
#      https://prod.spline.design/<id>/scene.splinecode)
#   5. Paste below.
#
# To verify the integration works without your own scene yet, you can
# temporarily use the Spline robot demo URL:
#   https://prod.spline.design/6Wq1Q7YGyM-iab9i/scene.splinecode
# ----------------------------------------------------------------------
NEXT_PUBLIC_SPLINE_SCENE_URL=""
